### VisualStudio Patch ###

# End of https://www.toptal.com/developers/gitignore/api/linux,macos,windows,visualstudio,jetbrains+all,visualstudiocode,dotenv,rust

# Build output directories, anywhere in the tree
bin/
target/

# Staged guest components and their manifests: generated by `make -C pkgs/extensions manifests`, removed by `clean`.
pkgs/extensions/**/*.wasm
ext/

# spike.wasm is a committed fixture (see make spike-guest); its test must not need a TinyGo install.
!pkgs/extensions/spike/spike.wasm

# wkg-fetched WIT deps — reproducible from the committed lock via `wkg wit fetch`
wit/**/deps/

# Generated by `make sbom`.
sbom.spdx.json
sbom.cdx.json
# cargo-cyclonedx writes each document beside its own manifest.
pkgs/*/*/*.cdx.json

# Cargo.lock is committed per workspace (applications, checked by `make lockfile`). A new workspace
# needs `git add -f`, since the Rust section above ignores Cargo.lock.
!/Cargo.lock
!pkgs/extensions/Cargo.lock

# Default session store (storage.path). Unanchored: it lands beside whichever config.yaml was booted.
# Anchored, a stray copy stayed tracked after a directory move.
jan-klod.db

/dist/

# Wasmtime compiled-component cache (storage.cache-dir default); regenerated on boot.
/wasmtime-cache/
# Also unanchored: a test booting scripts/distributions/<name>/ writes one beside that config.
wasmtime-cache/

# Agent working notes, local to a checkout
/.agents/TODO.md
/.agents/LOOP.md

# The TypeScript guest's transpiled bundle (#187), regenerated on each build.
pkgs/extensions/tool-hello-ts/build/

# componentize-py bindings, regenerated by `make -C pkgs/extensions py-guest`. app.py and pyproject.toml are hand-written.
pkgs/extensions/*/wit_world/
pkgs/extensions/*/componentize_py_async_support/
pkgs/extensions/*/componentize_py_types.py
pkgs/extensions/*/componentize_py_runtime.pyi
pkgs/extensions/*/poll_loop.py
pkgs/extensions/*/__pycache__/

# Confined commands' TMPDIR, created under the workspace, which can be this repository.
.jan-klod/

# Self-extension test fixture, from `make self-extend-fixture` (#221). Regenerate rather than hand-edit.
/.fixtures/
