package jan-klod:interfaces@0.3.0;

/// Outbound HTTP — the only network access extensions can make.
interface host-http {
    variant http-error {
        invalid-url,
        connection-failed,
        timeout,
        tls-error,
        /// HTTP 4xx — carries the status code.
        client-error(u16),
        /// HTTP 5xx — carries the status code.
        server-error(u16),
        backend,
    }

    record http-header {
        name: string,
        value: string,
    }

    record http-request {
        /// "GET" | "POST" | "PUT" | "PATCH" | "DELETE"
        method: string,
        url: string,
        headers: list<http-header>,
        /// Empty for GET/DELETE.
        body: option<list<u8>>,
        /// Timeout in milliseconds; 0 = use host default (30 000).
        timeout-ms: u32,
    }

    record http-response {
        status: u16,
        headers: list<http-header>,
        body: list<u8>,
    }

    /// Synchronous HTTP request. Extensions block until response is received.
    fetch: func(request: http-request) -> result<http-response, http-error>;
}
