package jan-klod:interfaces@0.1.0;

/// Minimal agent loop — the Phase-1 walking-skeleton orchestrator.
///
/// The full, streaming orchestrator is `agent-manager` (routing, fallback,
/// decomposition, tool loops); this `agent-loop` is the v0 cut that proves the
/// one mechanism those all depend on: **inter-component routing**. It imports
/// `llm-provider` and `memory-store` — interfaces *other* extensions export — and
/// the host satisfies those imports by routing each call into the implementing
/// extension. One turn: complete the prompt, persist it, return the text.
/// Implemented by: manager-agent-loop
interface agent-loop {
    /// Why a turn failed.
    enum agent-error {
        /// The routed provider failed to complete.
        provider-failed,
        /// The routed store failed to persist or read back.
        store-failed,
    }

    /// Run one turn: complete `prompt` through the routed `llm-provider`, persist
    /// the prompt+response through the routed `memory-store`, and return the
    /// completion text.
    run: func(prompt: string) -> result<string, agent-error>;
}

/// v0 manager world. Its `llm-provider` / `memory-store` imports are **not** host
/// capabilities — they are satisfied by the host routing to the provider/store
/// extensions (architecture.md: "talk to other extensions … routed through
/// core"). `host-config` is intentionally omitted: this loop reads no config of
/// its own (the provider and store read their own sections).
world agent-loop-world {
    import host-log;
    import llm-provider;
    import memory-store;

    export extension-lifecycle;
    export agent-loop;
}
