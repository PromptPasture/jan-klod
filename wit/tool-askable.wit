package jan-klod:interfaces@0.4.0;

/// A tool that can ask the user a question before it answers.
///
/// Return-then-reinvoke, not a callback: the tool returns `asking`, the host asks, then re-invokes with the answer.
/// No guest stays on the stack while the turn is suspended; a synchronous `host-ask` was rejected for that reason.
///
/// Probed, never required: no world requires this. The host checks each component for the export, as it does
/// for `client-surface`, so existing `tool-callable` guests are untouched.
interface tool-askable {
    use tool-callable.{tool-error};

    /// A question for the user, in the same shape `interceptor.wit` uses.
    /// Same record as `interceptor.wit`'s `user-prompt`, so clients and drivers need one vocabulary.
    record ask {
        question: string,
        /// Empty = free-text; non-empty = choose one.
        options: list<string>,
        /// Used when the driver cannot prompt (e.g. headless). The tool must be able to proceed on it: silence is an answer, not a hang.
        default-answer: string,
    }

    /// What one invocation produced.
    variant step {
        /// The tool is done; this is its JSON-encoded result.
        done(string),
        /// Needs an answer first; the host asks, then re-invokes with `answer` set.
        asking(ask),
    }

    /// Invoke the tool; `answer` is set only on re-invocation after `asking`.
    /// `arguments` is the original call's, unchanged.
    invoke-asking: func(arguments: string, answer: option<string>) -> result<step, tool-error>;
}

/// A tool that may ask; still exports `tool-callable`, which a host without this interface calls.
world tool-asking-world {
    include tool-world;

    export tool-askable;
}

/// Probe view: the host instantiates a component as this to check whether it can ask.
world tool-askable-view {
    export tool-askable;
}
