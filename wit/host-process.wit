package jan-klod:interfaces@0.4.0;

/// Run a command as a child process: the execution substrate.
///
/// **Code execution**, so host-owned and bounded: **default-deny** (off unless opted in), cwd **jailed to the workspace**,
/// and each run has a **timeout** and an **output cap**. The loop gates it at `tool-call` (`interceptor-permission`).
///
/// `exec` runs a command to completion, gated by `execution.enabled`. `spawn` holds a child open (stdio MCP
/// servers, `lsp-*`, browser drivers) and is **narrower**: gated by `execution.long-lived`, a list of named processes.
///
/// Implemented by the host; imported by execution `tool-*` extensions and, for the long-lived half only, `registry-mcp`.
interface host-process {
    /// Why an exec failed.
    enum proc-error {
        /// Execution is disabled, or the `cwd` escapes the workspace.
        denied,
        /// The command exceeded its time budget and was killed.
        timeout,
        /// The command could not be spawned (not found, permissions).
        spawn-failed,
    }

    /// The outcome of a completed command.
    record exit {
        /// Exit code, or -1 if terminated by a signal.
        code: s32,
        /// Captured stdout (truncated to the output cap).
        stdout: string,
        /// Captured stderr (truncated to the output cap).
        stderr: string,
    }

    /// Run `command` with `args`, an optional workspace-relative `cwd`, and optional
    /// `stdin`. Returns the exit code + captured output, or a `proc-error`.
    exec: func(
        command: string,
        args: list<string>,
        cwd: option<string>,
        stdin: option<string>,
    ) -> result<exit, proc-error>;

    /// Opaque handle to a running long-lived child.
    /// A `u32`, not a `resource` (as with `llm-provider`'s `stream-handle`): the host kills children when the instance stops.
    /// Handles are per-instance, so a forged integer reaches only the forger's own children.
    type child-handle = u32;

    /// The long-lived children this deployment granted, by name.
    ///
    /// Empty by default. Names only: the command and arguments stay host-side.
    /// Lets a tool discover valid names instead of guessing from refusals.
    granted: func() -> list<string>;

    /// Start the long-lived child **named** in `execution.long-lived`.
    ///
    /// Only the name is the guest's say: command and args come from config. Unknown names are `denied`.
    /// (the reason goes to the host log; `proc-error` carries no payload).
    ///
    /// Confined by the same sandbox as one-shot commands; outliving the call makes it more exposed, not less.
    spawn: func(name: string) -> result<child-handle, proc-error>;

    /// Write to the child's stdin; `denied` if the handle is not one of this instance's children.
    write-stdin: func(child: child-handle, data: string) -> result<_, proc-error>;

    /// Read at most `max-bytes` from stdout, waiting up to `timeout-ms` for the first byte.
    ///
    /// An empty string means nothing arrived in the window, not that the child exited: check `is-running`.
    read-stdout: func(
        child: child-handle,
        max-bytes: u32,
        timeout-ms: u32,
    ) -> result<string, proc-error>;

    /// Whether the child is alive; `false` for an invalid handle, so polling a dead child ends instead of erroring.
    is-running: func(child: child-handle) -> bool;

    /// Kill the child and release the handle. Idempotent; not needed, since the host kills leftovers on stop.
    kill: func(child: child-handle);
}
