package jan-klod:interfaces@0.4.0;

/// What a sandboxed extension may declare about a user interface it cannot see.
///
/// Clients are separate processes, so an extension cannot register a callback in one. Its only channel to a
/// person was `decision::ask`, a fixed-option question. Slash commands, status items and small forms had nowhere to live.
///
/// # Declaration, not drawing
///
/// An extension declares *what* it offers; each client renders it in its own idiom. No pixels, layout or toolkit
/// crosses this boundary, since the extension does not know which client, if any, is attached.
///
/// Declarations travel to clients over `jk-protocol`: a notification at connect and another when the set changes.
///
/// # Invocation is an export, not a phase
///
/// The host calls `invoke` when a client asks. It is not an `interceptor` phase: a user's command is not a point in
/// a turn. It is not a guest-initiated call either, because declarations are static and can be read once.
///
/// # The host probes for this export; no world requires it
///
/// A component must implement every export of its world, so putting this in `interceptor-world` or `tool-world` would
/// force every shipped guest to stub it. The host looks the export up on the instance; absence means "contributes nothing".
/// Contributing guests target `interceptor-contributor-world` below.
///
/// # Contributed text is data
///
/// Every string is **attacker-influenced** (e.g. an MCP tool description a guest puts in a `title`). Renderers escape
/// them: no terminal escapes, no markup, no layout-breaking length. The rule lives here, in the contract both sides read.
///
/// # A client that renders none of this still works
///
/// Contributions are additive. A client that ignores them runs turns as before. An extension must not assume a
/// contribution was rendered, offered, or seen.
interface client-surface {
    /// One argument a command takes.
    /// Shape only; the client decides whether it is a prompt, a field, or a positional word.
    record argument {
        /// Machine name, unique within the command.
        name: string,
        /// One line, shown to the user. Data, not markup.
        description: string,
        /// Whether the command can run without it.
        required: bool,
    }

    /// Something a user can invoke: a slash command, a menu entry, a button.
    record command {
        /// Machine name, unique across this extension, used by `invoke`.
        name: string,
        /// Short label. Data, not markup.
        title: string,
        /// One line of help. Data, not markup.
        description: string,
        /// In declaration order; a client renders them in that order.
        arguments: list<argument>,
    }

    /// Read-only state a client shows (a mode, a count, a connection).
    record status-item {
        /// Machine name, unique across this extension.
        name: string,
        /// The text to show, already short. Data, not markup.
        text: string,
        /// One line of detail, for a client with room for a tooltip.
        detail: string,
    }

    /// One field of a form.
    record field {
        name: string,
        /// Label. Data, not markup.
        label: string,
        /// Empty means free text; non-empty means choose one.
        options: list<string>,
        /// Used when the client cannot prompt, or the user declines to fill it.
        default-value: string,
    }

    /// A small set of fields gathered in one go, then handed to a command.
    /// Not a dialog: no layout, validation, or conditional fields. A client that cannot render a form asks one field at a time.
    record form {
        /// Machine name, unique across this extension, used by `invoke`.
        name: string,
        /// Short label. Data, not markup.
        title: string,
        fields: list<field>,
    }

    /// Everything one extension contributes; read at load and whenever the host believes it changed.
    record contributions {
        commands: list<command>,
        status-items: list<status-item>,
        forms: list<form>,
    }

    /// An argument as the client supplied it.
    record argument-value {
        name: string,
        value: string,
    }

    /// Why an invocation failed.
    enum invoke-error {
        /// No command or form of that name is contributed.
        unknown,
        /// A required argument was missing, or a value was unusable.
        invalid-arguments,
        /// The extension could not carry it out.
        failed,
    }

    /// What an invocation produced.
    /// Text only: rendering is the client's, and anything richer goes through the session transcript.
    record outcome {
        /// Shown to the user. Data, not markup.
        text: string,
        /// Whether the contribution set changed, so the host re-reads it and notifies clients.
        contributions-changed: bool,
    }

    /// What this extension contributes. Called by the host; must not block.
    contribute: func() -> contributions;

    /// Run a contributed command or form, when a client asks for it; never by the loop.
    invoke: func(name: string, arguments: list<argument-value>) -> result<outcome, invoke-error>;
}

/// An interceptor that also contributes to the client surface.
/// Exists because a guest must implement every export of its world, so this adds the export without forcing it on all interceptors.
world interceptor-contributor-world {
    include interceptor-world;

    export client-surface;
}

/// The host's view of a component that contributes; not a world guests are authored against.
/// The host instantiates a guest against its category world, then reads this export off the same instance.
/// One world with one export and no imports makes the probe typed: absent means contributes nothing.
/// Guests target `interceptor-contributor-world`, never this world.
world client-surface-view {
    export client-surface;
}
