package jan-klod:interfaces@0.4.0;

/// Agent-loop decision hook: the interface every `interceptor-*` extension exports.
/// The core loop runs an ordered list of phases, calling each enabled interceptor's `intercept` natively.
///
/// Design rules:
///   - **One function, many phases.** A new lifecycle point is a new `phase` case, never a new function or import.
///   - **Narrow phases.** Each is a real state transition, so ordering is structural rather than config-driven.
///   - **Zero policy in core.** Decisions live here; the loop holds only mechanism (streaming, retry, fallback, cancel, queueing).
///   - **Core-native dispatch.** An exported interface the host calls, not a capability extensions import.
interface interceptor {
    use llm-types.{message, tool-definition, tool-call};

    /// Opaque session identifier (a session spans many loop runs).
    type session-id = string;

    /// The lifecycle points, in dispatch order.
    ///
    /// **Every case is dispatched by the loop**: a declared but unreached phase lets an extension load, report healthy, and never run.
    /// `jk_protocol::intercept::is_dispatched` enforces this at compile time.
    enum phase {
        /// Per run, before the agentic loop; may short-circuit to a direct answer (default: interceptor-intent-router).
        before-loop,
        /// Picks the model first; context and tools depend on it.
        select-model,
        /// Trims or compresses history to the chosen model's budget.
        select-context,
        /// Fixes the tool set for the task.
        select-tools,
        /// Raw assistant output, before core parses or validates it: repair, reasoning-strip, redaction.
        /// A `replace` here rewrites the turn's authoritative message (see `finalize`).
        after-response,
        /// A tool is about to be invoked: allow, block, modify, or ask.
        /// Default: interceptor-permission.
        tool-call,
        /// A tool has returned. Modify the result or terminate the loop.
        tool-result,
        /// Final answer assembled. Streamed tokens are a non-authoritative preview, so `finalize` edits the
        /// authoritative copy (e.g. citations, redaction) rather than emitted tokens.
        finalize,
        /// A new iteration is about to begin. Optional model/context swap.
        prepare-next-turn,
    }

    /// Outbound completion under assembly, which the request-shaping phases read and replace.
    /// Mirrors `llm-provider.completion-request`; separate so interceptors don't import the provider world.
    record pending-request {
        /// None until select-model sets it.
        model: option<string>,
        messages: list<message>,
        tools: list<tool-definition>,
        /// Constrained-decoding grammar; core supplies a default, which an interceptor may override or clear.
        grammar: option<string>,
        max-tokens: option<u32>,
        temperature: option<f32>,
    }

    record user-turn {
        session: session-id,
        user-message: string,
        principal: option<string>,
    }

    /// Raw model output before parsing.
    record raw-response {
        text: string,
        /// "stop" | "tool-calls" | "length" | "error"
        finish-reason: string,
    }

    record tool-outcome {
        tool-call-id: string,
        /// Tool result content (may be modified).
        content: string,
    }

    record final-answer {
        text: string,
    }

    /// Phase-specific state handed to the interceptor. The active case always
    /// matches the phase the host is dispatching.
    variant hook-state {
        before-loop(user-turn),
        select-model(pending-request),
        select-context(pending-request),
        select-tools(pending-request),
        after-response(raw-response),
        tool-call(tool-call),
        tool-result(tool-outcome),
        finalize(final-answer),
        prepare-next-turn(pending-request),
    }

    /// A question routed through the loop to the attached driver (TUI, chat, api-*), which renders it in its own idiom.
    /// The interceptor never touches a UI: the loop suspends, the driver answers, and the same interceptor is re-invoked with `answer` set.
    record user-prompt {
        question: string,
        /// Empty = free-text; non-empty = choose one.
        options: list<string>,
        /// If the driver cannot prompt (headless, no answer), the loop uses this.
        default-answer: string,
    }

    /// Why an action was blocked (surfaced to the user / transcript).
    record block-reason {
        message: string,
    }

    /// An interceptor's internal failure, distinct from `block` (a decision).
    /// On `Err` or a trap: fail **closed** at `tool-call` (as `block`, so a broken gate never fails open);
    /// elsewhere, log and `proceed` so one faulty interceptor cannot wedge the loop. It is reported on the event bus.
    enum interceptor-error {
        /// Unhandled internal error.
        internal,
        /// State did not match the dispatched phase, or was otherwise unusable.
        invalid-state,
        /// A capability the interceptor needed (e.g. routed llm-provider) failed.
        dependency-failed,
    }

    /// What the interceptor decided.
    variant decision {
        /// No change; continue.
        proceed,
        /// Replace the phase state with this (same active case as the input).
        replace(hook-state),
        /// Stop this action (e.g. deny a tool call, short-circuit the loop).
        block(block-reason),
        /// Ask the user, then resume (host re-invokes with `answer` set).
        ask(user-prompt),
    }

    /// Input to a single dispatch.
    record intercept-input {
        phase: phase,
        state: hook-state,
        /// Present only on re-invocation after this interceptor returned `ask`.
        answer: option<string>,
    }

    /// Called at each phase, synchronously, at turn boundaries (never mid-token). `Err` follows the policy on `interceptor-error`.
    intercept: func(input: intercept-input) -> result<decision, interceptor-error>;

    /// Phases this interceptor is dispatched to; the host skips the rest.
    /// Ordering comes only from here: the `phase` declaration order across phases, load order within one phase.
    /// `config.yaml` only enables or disables interceptors; it never orders them.
    subscribed-phases: func() -> list<phase>;
}

/// Interceptor world: the host calls `interceptor` directly; `host-event` is for observation only.
///
/// `llm-provider` is imported because some decisions need a model (e.g. task routing, history summarisation).
/// An interceptor that needs no model never calls it; the import costs nothing until used.
world interceptor-world {
    import host-log;
    import host-config;
    import host-event;
    import host-storage;
    import llm-provider;

    export extension-lifecycle;
    export interceptor;
}
