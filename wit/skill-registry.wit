package jan-klod:interfaces@0.1.0;

/// Skill catalog — discovers and dispatches named skills from .agents/skills/.
/// Implemented by: registry-skills
interface skill-registry {
    enum skill-error {
        not-found,
        execution-failed,
        backend,
    }

    /// Metadata for a registered skill.
    record skill-info {
        name: string,
        description: string,
        /// Path to the skill file on disk.
        path: string,
        /// JSON Schema string for arguments.
        arguments-schema: string,
    }

    /// List all available skills.
    list-skills: func() -> result<list<skill-info>, skill-error>;

    /// Look up a skill by name.
    get-skill: func(name: string) -> result<skill-info, skill-error>;

    /// Invoke a skill with JSON-encoded arguments. Returns JSON-encoded output.
    invoke: func(name: string, arguments: string) -> result<string, skill-error>;

    /// Reload skill definitions from disk (triggered by config hot-reload).
    reload: func() -> result<_, skill-error>;
}

world skill-registry-world {
    import host-log;
    import host-config;

    export extension-lifecycle;
    export skill-registry;
}
