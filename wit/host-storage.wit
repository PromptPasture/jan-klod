package jan-klod:interfaces@0.4.0;

/// A namespaced view of the core's own store, for extensions that need persistence.
/// The store stays host-side: the sandbox has no filesystem, and the transcript is too sensitive to hand a guest.
///
/// Granted, not ambient: without `persist: true` writes go to a map that dies with the process, keeping grants run-scoped.
/// Namespaces are prefixed with the caller's component id, so a guest cannot reach a peer's namespace or a transcript.
///
/// Deliberately narrow: no purge, no search, no way to enumerate namespaces.
interface host-storage {
    use store-types.{entry, store-error};

    set: func(namespace: string, key: string, value: string) -> result<entry, store-error>;
    get: func(namespace: string, key: string) -> result<entry, store-error>;
    delete: func(namespace: string, key: string) -> result<_, store-error>;
    list-keys: func(namespace: string) -> result<list<entry>, store-error>;
    recent: func(namespace: string, limit: u32) -> result<list<entry>, store-error>;
}
