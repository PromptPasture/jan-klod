package jan-klod:interfaces@0.3.0;

/// Secrets access — retrieve named secrets from the configured backend.
///
/// Host-provided: the guest reads secrets only by name. No enumeration, listing,
/// or backend introspection is possible. **Default-deny:** a guest that imports
/// this interface but is not granted `secrets: true` in config.yaml sees `denied`
/// for every call.
///
/// Implemented by the host; imported by extensions that need API keys or
/// credentials.
interface host-secrets {
    /// Why a secret operation failed.
    enum secrets-error {
        /// The backend has no secret with this name.
        not-found,
        /// The guest is not granted the host-secrets capability.
        denied,
        /// An underlying backend error (misconfigured, unreachable, …).
        backend,
    }

    /// The secret named `name`, from the backend the operator configured
    /// (e.g., environment variables, system keychain, …).
    get: func(name: string) -> result<string, secrets-error>;
}
