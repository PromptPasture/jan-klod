package jan-klod:interfaces@0.4.0;

/// Secrets access — retrieve named secrets from the configured backend.
///
/// Host-provided: secrets are read by name only; no enumeration or backend introspection.
/// **Default-deny:** without `secrets: true` in config.yaml, every call returns `denied`.
///
/// Implemented by the host; imported by extensions that need credentials.
interface host-secrets {
    /// Why a secret operation failed.
    enum secrets-error {
        /// The backend has no secret with this name.
        not-found,
        /// The guest is not granted the host-secrets capability.
        denied,
        /// An underlying backend error (misconfigured, unreachable, …).
        backend,
    }

    /// The secret named `name`, from the operator-configured backend (env vars, keychain, …).
    get: func(name: string) -> result<string, secrets-error>;
}
