package jan-klod:spike@0.1.0;

/// Throwaway gate world for Slice 1a (go/no-go): proves a Rust + Wasmtime host can load a TinyGo component.
/// Kept out of `jan-klod:interfaces` on purpose; delete with `pkgs/extensions/spike/` once the verdict is recorded.
world spike {
    /// TinyGo's wasip2 runtime imports `wasi:cli/*` at startup; re-expose them or `wasm-tools component new` fails.
    include wasi:cli/imports@0.2.0;

    /// Echo the prompt back. The host prints whatever this returns.
    export complete: func(prompt: string) -> string;
}
