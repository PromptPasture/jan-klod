package jan-klod:interfaces@0.1.0;

/// Conversation context — owns history, compresses before token budget is exceeded.
/// Implemented by: manager-context
interface context-manager {
    use llm-types.{message, role};

    enum context-error {
        session-not-found,
        backend,
    }

    /// Opaque session identifier.
    type session-id = string;

    /// Append a message to the session history.
    append: func(session: session-id, msg: message) -> result<_, context-error>;

    /// Return the current message list for a session, compressed to fit within
    /// token-budget. Compression strategy is implementation-defined (truncate,
    /// summarise, sliding window).
    messages: func(session: session-id, token-budget: u32) -> result<list<message>, context-error>;

    /// Discard all history for a session.
    clear: func(session: session-id) -> result<_, context-error>;

    /// Estimate token count for the current history (implementation-defined model).
    token-count: func(session: session-id) -> result<u32, context-error>;

    /// Create a new session. Returns the session-id.
    new-session: func() -> result<session-id, context-error>;

    /// Delete a session and all its history.
    delete-session: func(session: session-id) -> result<_, context-error>;
}

world context-manager-world {
    import host-log;
    import host-config;
    import host-storage;

    export extension-lifecycle;
    export context-manager;
}
