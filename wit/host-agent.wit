package jan-klod:interfaces@0.4.0;

/// Drive a session from inside the sandbox: the inward twin of the client protocol.
///
/// Offers the `jk-protocol` vocabulary (create, list, read, fork, send, answer) to a granted guest.
/// Where shapes differ, `pkgs/host/protocol/src/lib.rs` is right and this follows it.
///
/// The most powerful capability in the set, so it is **default-deny**: granted per component in
/// `config.yaml`, declared in the manifest, and cross-checked at boot against its imports.
///
/// Implemented by the host; imported by `chat-*` extensions and other session drivers.
///
/// # What a grant reaches
///
/// The sessions the component created, plus the session that invoked it. `create-session` records the
/// caller as owner, and every later call checks that record. A wider prefix grant (for exporters or
/// archivers) must be written in `config.yaml` and declared in the manifest.
///
/// Lineage is host-resolved: a fork's parent is reachable because the host knows the link, never because
/// a guest named a guessed id.
///
/// Scope follows Claude Code, Codex and MCP, but enforcement is a capability rather than an OS path:
/// a hook there can open a sibling transcript file; here it cannot.
///
/// # When the driver dies mid-turn
///
/// A trap leaves the turn **abandoned and recorded incomplete** through the conductor's existing path,
/// never silently dropped and never left looking finished. Host behaviour only; no function expresses it.
interface host-agent {
    use llm-types.{message};

    /// Opaque session identifier, the same string the client protocol uses.
    type session-id = string;

    /// Why a call failed.
    /// `busy` is separate from `failed` so callers can wait and retry; queuing is the caller's policy.
    enum agent-error {
        /// No grant, or a session outside the one held. Not distinguished from absence: that would leak existence.
        denied,
        /// A turn is already running in this session. See `send-message`.
        busy,
        /// No such session, within what this component may reach.
        not-found,
        /// The host could not serve the call (store failure, boot state).
        failed,
    }

    /// One session as listed; mirrors the client protocol's session-list projection.
    record session-summary {
        id: session-id,
        /// First 80 characters of the first user message.
        preview: string,
    }

    /// A session's messages, as `session/get` returns them.
    record transcript {
        session: session-id,
        messages: list<message>,
        /// Log position of the last message (the `at-seq` for `fork-session`); sparse, since events consume positions too.
        last-seq: u64,
    }

    /// What a fork produced.
    record fork-result {
        /// The child session id, generated by the host so a guest cannot collide with a live session.
        id: session-id,
        /// How many events were copied.
        copied: u64,
    }

    /// A tool the loop is about to run, or has run.
    record tool-event {
        /// Call id; a `tool-finished` carries the id of the `tool-started` it answers.
        id: string,
        /// Tool name on `tool-started`; empty on `tool-finished`.
        name: string,
        /// JSON arguments on `tool-started`, result content on `tool-finished`.
        body: string,
        /// Whether the call failed. Meaningful on `tool-finished` only.
        failed: bool,
    }

    /// A question the turn is blocked on. Answer it with `answer-prompt`;
    /// leaving it unanswered takes `default-answer`, as everywhere else.
    record prompt {
        question: string,
        /// Empty means free text; non-empty means choose one.
        options: list<string>,
        default-answer: string,
    }

    /// What happened in a session since the last poll.
    ///
    /// The same events, in the same order, that the client protocol notifies.
    variant event {
        /// A chunk of assistant text.
        text-delta(string),
        /// A tool is about to run, the `tool-call` gate having allowed it.
        tool-started(tool-event),
        /// A tool returned.
        tool-finished(tool-event),
        /// A non-fatal notice — a provider fallback, a degraded path.
        warning(string),
        /// The turn finished; carries the authoritative answer.
        done(string),
        /// The turn is blocked on the user.
        asked(prompt),
        /// The turn failed.
        failed(string),
    }

    /// Allocate a session owned by the calling component.
    /// Ownership is what the default grant reaches, so this call creates reach.
    create-session: func() -> result<session-id, agent-error>;

    /// The sessions this component may reach.
    /// Its own sessions and the one that invoked it; a prefix grant adds that prefix.
    list-sessions: func() -> result<list<session-summary>, agent-error>;

    /// Every session in the store.
    ///
    /// A separate function behind its own grant, not a flag on `list-sessions`: a flag is easy to pass by accident.
    list-all-sessions: func() -> result<list<session-summary>, agent-error>;

    /// Read one session's messages.
    get-session: func(session: session-id) -> result<transcript, agent-error>;

    /// Fork a session at `at-seq` into a fresh child, owned by this component.
    ///
    /// The parent must be reachable; the child is owned by this component from creation.
    fork-session: func(session: session-id, at-seq: u64) -> result<fork-result, agent-error>;

    /// Start a turn; returns once accepted. Events arrive via `next-events`.
    /// A session already running a turn returns `busy`: no host-side queue, since a guest knows its own conversation.
    send-message: func(session: session-id, text: string) -> result<_, agent-error>;

    /// Take up to `max` events from the session's queue, oldest first.
    /// Polling, not push: the host is synchronous and cannot call into a guest. A call returns what fits; poll again for more.
    /// Empty means nothing has happened yet, not an error.
    next-events: func(session: session-id, max: u32) -> result<list<event>, agent-error>;

    /// Answer the prompt a `asked` event carried.
    /// What makes the holder a **driver** rather than an observer.
    /// Answering with nothing pending is `not-found`, not a silent success.
    answer-prompt: func(session: session-id, answer: string) -> result<_, agent-error>;
}
