#!/usr/bin/env bash
# Pre-push hook: the full exit gate.
# Skip with: git push --no-verify
#
# The sequence lives in the Makefile's `gate-push` target, shared with CI.
# Env such as CARGO_TERM_COLOR is also set there, so both sides parse tool
# output the same way.

set -euo pipefail

RED='\033[0;31m'
GRN='\033[0;32m'
RST='\033[0m'

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if make gate-push; then
  printf "\n${GRN}✓${RST} All CI gates passed.\n\n"
else
  printf "\n${RED}✗${RST} pre-push gate failed — see above.\n\n" >&2
  exit 1
fi
