#!/usr/bin/env bash
# Pre-commit hook — compilation + tests only (fast gate).
# Skip with: git commit --no-verify

set -euo pipefail

RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
BLD='\033[1m'
RST='\033[0m'

pass() { printf "${GRN}✓${RST} %s\n" "$*"; }
fail() { printf "${RED}✗${RST} %s\n" "$*" >&2; }
step() { printf "\n${BLD}${YLW}▶ %s${RST}\n" "$*"; }

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Skip entirely unless the commit touches something Rust build output depends
# on, so doc/workflow-only commits stay instant. wit/ is included because guest
# crates read it at compile time via wit_bindgen::generate!.
if ! git diff --cached --name-only --diff-filter=ACM \
     | grep -qE '\.rs$|Cargo\.(toml|lock)$|^wit/'; then
  exit 0
fi

step "rustfmt"
cargo fmt --manifest-path src/core/Cargo.toml --all -- --check \
  && pass "core formatted" \
  || { fail "src/core unformatted — run: cargo fmt --manifest-path src/core/Cargo.toml --all"; exit 1; }

cargo fmt --manifest-path src/extensions/Cargo.toml --all -- --check \
  && pass "extensions formatted" \
  || { fail "src/extensions unformatted — run: cargo fmt --manifest-path src/extensions/Cargo.toml --all"; exit 1; }

step "Build + test"

# Stage the guests fresh. This used to be `rm -rf ext/` alone, which defeated its
# own purpose: the integration tests skip when a guest is absent, so removing them
# turned roughly thirty tests into no-ops and the hook still printed "passed".
# Removing *and rebuilding* gets what the removal was reaching for — no stale
# artifact — while leaving the tests something to run against.
rm -rf ext/
make -C src/extensions all \
  && pass "guests staged" \
  || { fail "guest build failed"; exit 1; }

# A skipped test must now fail rather than pass quietly (see common::guests_staged).
export JK_REQUIRE_GUESTS=1

make -C src/core check \
  && pass "core check" \
  || { fail "core check failed"; exit 1; }

make test \
  && pass "make test" \
  || { fail "make test failed"; exit 1; }

printf "\n${GRN}${BLD}Build and tests passed.${RST}\n\n"
