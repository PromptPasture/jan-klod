#!/usr/bin/env bash
# Pre-commit hook: markdown lint, then build and unit tests (fast gate).
# Skip with: git commit --no-verify
#
# The sequence lives in the Makefile's `gate-commit` target, shared with CI.
# Integration tests are not in it; they run at push (pre-push).

set -euo pipefail

RED='\033[0;31m'
GRN='\033[0;32m'
RST='\033[0m'

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACM)"

# Fail rather than skip: CI rejects unlinted markdown anyway.
if grep -q '\.md$' <<<"$STAGED"; then
  if ! command -v npx >/dev/null; then
    printf "${RED}✗${RST} .md files staged but npx is not on PATH — install Node 22 (see docs/guides/development-setup.md).\n" >&2
    exit 1
  fi
  if ! make lint-docs; then
    printf "\n${RED}✗${RST} markdown lint failed — see above.\n\n" >&2
    exit 1
  fi
fi

# Skip the build gate unless the staged diff touches Rust build inputs (wit/
# is read at compile time by guest crates). Needs the staged diff, so it
# stays in the hook, not the Makefile.
if ! grep -qE '\.rs$|Cargo\.(toml|lock)$|^wit/' <<<"$STAGED"; then
  exit 0
fi

if make gate-commit; then
  printf "\n${GRN}✓${RST} Build and tests passed.\n\n"
else
  printf "\n${RED}✗${RST} pre-commit gate failed — see above.\n\n" >&2
  exit 1
fi
