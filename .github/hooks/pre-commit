#!/usr/bin/env bash
# Pre-commit hook — compilation + tests only (fast gate).
# Skip with: git commit --no-verify

set -euo pipefail

RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
BLD='\033[1m'
RST='\033[0m'

pass() { printf "${GRN}✓${RST} %s\n" "$*"; }
fail() { printf "${RED}✗${RST} %s\n" "$*" >&2; }
step() { printf "\n${BLD}${YLW}▶ %s${RST}\n" "$*"; }

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

step "Build + test"

rm -rf ext/

make -C src/core build \
  && pass "core build" \
  || { fail "core build failed"; exit 1; }

make test \
  && pass "make test" \
  || { fail "make test failed"; exit 1; }

printf "\n${GRN}${BLD}Build and tests passed.${RST}\n\n"
